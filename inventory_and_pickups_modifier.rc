#include <winver.h>

/* The version resource for the Inventory and Pickups Modifier. Bump the version
   here when the modifier is released. */

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,1,0
 PRODUCTVERSION 1,0,1,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "mwith77"
            VALUE "FileDescription",  "Inventory and Pickups Modifier"
            VALUE "FileVersion",      "v1.0.1"
            VALUE "InternalName",     "inventory_and_pickups_modifier"
            VALUE "LegalCopyright",   "mwith77"
            VALUE "OriginalFilename", "inventory_and_pickups_modifier.dll"
            VALUE "ProductName",      "Inventory and Pickups Modifier"
            VALUE "ProductVersion",   "v1.0.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
